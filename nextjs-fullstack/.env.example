# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ahmad_portfolio"

# Admin authentication credentials
# Generate ADMIN_PASSWORD_HASH with: npm run auth:hash -- "your-strong-password"
ADMIN_EMAIL="ahmato-123@hotmail.com"
ADMIN_PASSWORD_HASH=""

# 32+ character random secret for signing HttpOnly admin session cookies
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Directory for uploaded project screenshots (relative to project root)
UPLOAD_DIR="public/uploads"

# Contact form rate limiting
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
